# Production entry point. Same routing as infra/caddy/Caddyfile, three
# differences: a real domain instead of localhost, a certificate from Let's
# Encrypt instead of Caddy's internal CA, and HSTS, which is only safe once the
# name is ours.
#
# Copy this next to compose.deploy.yml as `Caddyfile`; that is the path the
# caddy service bind-mounts.
{
	email {$ACME_EMAIL}

	# Request metrics for Prometheus, served by the :2020 site below. The admin
	# API on :2019 serves them too, but it can rewrite the config, so it stays
	# on loopback where the healthcheck uses it.
	metrics
}

{$SITE_DOMAIN} {
	log

	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Safe here and not in the dev Caddyfile: HSTS is keyed on the host name
		# and ignores the port, so pinning it to localhost would force https on
		# every other project a teammate runs there. A real domain is ours to pin.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# NestJS sets a global "api" prefix, so the prefix is forwarded intact.
	# handle_path would strip it and every route would answer 404.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3001
	}

	# socket.io. Caddy 2 detects the Upgrade handshake inside reverse_proxy.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy api:3001
	}

	# Grafana's own metrics are off (grafana.ini) and unauthenticated when on.
	# Refused here too, so a config slip cannot publish them. Before @grafana:
	# handle blocks with named matchers keep the order they are written in.
	@grafana_metrics path /grafana/metrics /grafana/metrics/*
	handle @grafana_metrics {
		respond 404
	}

	# Grafana serves itself under /grafana, prefix intact, like /api above.
	@grafana path /grafana /grafana/*
	handle @grafana {
		reverse_proxy grafana:3000 {
			# Grafana reads X-Real-IP before the socket address, and Caddy
			# passes a client-sent one through. Overwrite it, or the login
			# lockout per IP can be dodged with a fake header.
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

# Prometheus scrapes this over the compose network. compose.deploy.yml does not
# publish it, so nothing outside the network can reach it.
http://:2020 {
	metrics
}
