# Production environment for compose.deploy.yml. Copy to `.env` next to it on
# the server and fill in. Never commit the filled copy.
#
# Separate from the repo-root .env.example, which configures a local checkout:
# the keys that look shared (POSTGRES_*, SESSION_SECRET, LLM_*) have dev defaults
# there and none here, so production cannot fall back to a public secret.
#
# Only these three files go on the host:
#   compose.deploy.yml
#   Caddyfile            (infra/caddy/Caddyfile.prod, renamed)
#   .env                 (this, filled in)

# The public hostname. Ours, and it must resolve to the host before the stack
# starts or Caddy burns a Let's Encrypt attempt failing to validate.
SITE_DOMAIN=transcendence.dpdns.org

# Where the certificate authority reports a renewal it could not complete.
ACME_EMAIL=you@example.com

# Which released images to run. `latest` follows main; pin to a main-<sha> tag
# to hold a known-good release, and to roll back.
IMAGE_TAG=latest

# Signs session cookies. At least 32 characters, and nothing this repo has ever
# seen. Generate with: openssl rand -base64 48
SESSION_SECRET=

# The database password. No fallback on purpose. Hex, not base64: this goes into
# DATABASE_URL, and a `/` there terminates the authority and breaks the parse.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=ft
POSTGRES_DB=ft_transcendence

# The AI provider. `fixture` needs no key and is what CI runs.
LLM_PROVIDER=fixture
LLM_API_KEY=
LLM_MODEL=
