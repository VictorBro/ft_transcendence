{
  "name": "ft-transcendence",
  "version": "0.0.0",
  "private": true,
  "description": "AI-driven foreign language learning platform (42 ft_transcendence)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24.22.3 <25.0.0",
    "pnpm": ">=11.28.11"
  },
  "scripts": {
    "prepare": "if command -v husky >/dev/null 2>&1; then husky; fi",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm run format:check && turbo run lint typecheck test:cov build"
  },
  "devDependencies": {
    "@ft/eslint-config": "workspace:*",
    "@ft/tsconfig": "workspace:*",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": ["prettier --write --ignore-unknown"]
  }
}
