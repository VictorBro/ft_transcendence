# Production environment for compose.deploy.yml. Copy to `.env` next to it on
# the server and fill in. Never commit the filled copy.
#
# Only these three files go on the host:
#   compose.deploy.yml
#   Caddyfile            (infra/caddy/Caddyfile.prod, renamed)
#   .env                 (this, filled in)

# The public hostname. Must already resolve to this host, or the certificate
# cannot be issued.
SITE_DOMAIN=/home/vic/Documents/cprojects/ft_transcendence/.env

# Where the certificate authority reports a renewal it could not complete.
ACME_EMAIL=you@example.com

# Which released images to run. `latest` follows main; pin to a main-<sha> tag
# to hold a known-good release, and to roll back.
IMAGE_TAG=latest

# Signs session cookies. At least 32 characters, and nothing this repo has ever
# seen. Generate with: openssl rand -base64 48
SESSION_SECRET=

# The database password. The compose file has no fallback for it on purpose.
POSTGRES_PASSWORD=
POSTGRES_USER=ft
POSTGRES_DB=ft_transcendence

# The AI provider. `fixture` needs no key and is what CI runs.
LLM_PROVIDER=fixture
LLM_API_KEY=
LLM_MODEL=
