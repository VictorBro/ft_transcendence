{
  "name": "@ft/e2e",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Playwright suite run against the production compose stack: user flows, console gate, legal pages.",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install --with-deps chromium firefox webkit",
    "test:e2e": "pnpm --filter @ft/shared run build && playwright test",
    "test:e2e:restart": "pnpm --filter @ft/shared run build && E2E_RESTART=1 playwright test --project=chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@ft/eslint-config": "workspace:*",
    "@ft/shared": "workspace:*",
    "@ft/tsconfig": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "otpauth": "9.6.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
