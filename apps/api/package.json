{
  "name": "@ft/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend: business logic and data access for ft_transcendence",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch --config nest-cli.dev.json",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "generation:try": "tsx --env-file-if-exists=../../.env scripts/try-generation.ts",
    "outlines:check": "tsx scripts/check-outlines.ts",
    "lessons:author": "pnpm --filter @ft/shared run build && tsx scripts/lessons/author.ts",
    "lessons:check": "pnpm --filter @ft/shared run build && tsx scripts/lessons/check.ts"
  },
  "dependencies": {
    "@ft/shared": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/platform-socket.io": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-redis": "10.0.0",
    "express-session": "1.19.0",
    "multer": "2.5.0",
    "nestjs-zod": "5.6.0",
    "otpauth": "9.6.0",
    "qrcode-generator": "2.0.4",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ft/eslint-config": "workspace:*",
    "@ft/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
