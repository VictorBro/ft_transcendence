{
  "name": "@ft/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js frontend: presentation and SSR only, all domain logic lives in @ft/api",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@ft/shared": "workspace:*",
    "@ft/ui": "workspace:*",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "socket.io-client": "4.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ft/eslint-config": "workspace:*",
    "@ft/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
