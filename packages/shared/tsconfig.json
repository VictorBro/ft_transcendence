{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ft/tsconfig/library.json",
  // The typecheck view: source plus tests. tsconfig.build.json narrows this to
  // what ships. incremental is off here so the two configs cannot fight over one
  // .tsbuildinfo file.
  //
  // Node's types are for the tests, which read their fixtures from disk.
  // tsconfig.build.json removes them, so the source that ships stays free of
  // Node APIs: a browser bundles this package too.
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": false,
    "types": ["node"],
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
}
