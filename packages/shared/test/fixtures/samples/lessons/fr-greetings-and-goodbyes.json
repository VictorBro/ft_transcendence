          "items": [
            {
              "type": "function_dialogue",
              "itemId": "dialogue",
              "lines": [
                {
                  "lineId": "line-1",
                  "roleId": "lea",
                  "text": "Bonjour, Hugo !",
                  "translation": {
                    "en": "Hello, Hugo!",
                    "de": "Guten Morgen, Hugo!"
                  },
                  "note": {
                    "en": "In the morning Léa greets Hugo with bonjour.",
                    "fr": "Le matin, Léa salue Hugo avec bonjour.",
                    "de": "Am Morgen grüßt Léa Hugo mit bonjour."
                  },
                  "expressionIds": ["bonjour"]
                },
                {
                  "lineId": "line-2",
                  "roleId": "hugo",
                  "text": "Salut, Léa ! Ça va ?",
                  "translation": {
                    "en": "Hi, Léa! How are you?",
                    "de": "Hallo, Léa! Wie geht’s?"
                  },
                  "note": {
                    "en": "Friends often say salut; Ça va ? asks how she is.",
                    "fr": "Entre amis, on dit souvent salut ; Ça va ? demande comment elle va.",
                    "de": "Freunde sagen oft salut; Ça va ? fragt, wie es ihr geht."
                  },
                  "expressionIds": ["ca-va"]
                },
                {
                  "lineId": "line-3",
                  "roleId": "lea",
                  "text": "Ça va bien, merci. Et toi ?",
                  "translation": {
                    "en": "I’m fine, thanks. And you?",
                    "de": "Mir geht’s gut, danke. Und dir?"
                  },
                  "note": {
                    "en": "She answers, then asks back with Et toi ?",
                    "fr": "Elle répond, puis retourne la question avec Et toi ?",
                    "de": "Sie antwortet und fragt mit Et toi ? zurück."
                  },
                  "expressionIds": ["ca-va", "ca-va-bien"]
                },
                {
                  "lineId": "line-4",
                  "roleId": "hugo",
                  "text": "Pas mal, merci.",
                  "translation": {
                    "en": "Not bad, thanks.",
                    "de": "Nicht schlecht, danke."
                  },
                  "note": {
                    "en": "Pas mal is a relaxed positive answer.",
                    "fr": "Pas mal est une réponse positive et décontractée.",
                    "de": "Pas mal ist eine lockere, positive Antwort."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "line-5",
                  "roleId": "lea",
                  "text": "Tu vas au travail ?",
                  "translation": {
                    "en": "Are you going to work?",
                    "de": "Gehst du zur Arbeit?"
                  },
                  "note": {
                    "en": "A little small talk after the greeting.",
                    "fr": "Un peu de conversation après la salutation.",
                    "de": "Ein bisschen Smalltalk nach dem Gruß."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "line-6",
                  "roleId": "hugo",
                  "text": "Oui. Bonne journée, Léa !",
                  "translation": {
                    "en": "Yes. Have a nice day, Léa!",
                    "de": "Ja. Einen schönen Tag, Léa!"
                  },
                  "note": {
                    "en": "Bonne journée is a friendly wish when you leave during the day.",
                    "fr": "Bonne journée est un souhait amical quand on part pendant la journée.",
                    "de": "Bonne journée ist ein freundlicher Wunsch beim Abschied tagsüber."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "line-7",
                  "roleId": "lea",
                  "text": "Merci ! À bientôt !",
                  "translation": {
                    "en": "Thanks! See you soon!",
                    "de": "Danke! Bis bald!"
                  },
                  "note": {
                    "en": "À bientôt: they will see each other again soon.",
                    "fr": "À bientôt : ils vont bientôt se revoir.",
                    "de": "À bientôt: Sie sehen sich bald wieder."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "line-8",
                  "roleId": "hugo",
                  "text": "Au revoir !",
                  "translation": {
                    "en": "Goodbye!",
                    "de": "Tschüss!"
                  },
                  "note": {
                    "en": "Au revoir works with everyone.",
                    "fr": "Au revoir convient avec tout le monde.",
                    "de": "Au revoir passt bei allen."
                  },
                  "expressionIds": ["au-revoir"]
                },
                {
                  "lineId": "line-9",
                  "roleId": "lea",
                  "text": "Bonsoir, Hugo ! Tu rentres ?",
                  "translation": {
                    "en": "Good evening, Hugo! Are you going home?",
                    "de": "Guten Abend, Hugo! Gehst du nach Hause?"
                  },
                  "note": {
                    "en": "The same day, in the evening: now Léa says bonsoir.",
                    "fr": "Le même jour, le soir : maintenant Léa dit bonsoir.",
                    "de": "Am selben Tag, am Abend: Jetzt sagt Léa bonsoir."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "line-10",
                  "roleId": "hugo",
                  "text": "Oui. Bonne soirée !",
                  "translation": {
                    "en": "Yes. Have a nice evening!",
                    "de": "Ja. Einen schönen Abend!"
                  },
                  "note": {
                    "en": "Bonne soirée is the evening version of bonne journée.",
                    "fr": "Bonne soirée est la version du soir de bonne journée.",
                    "de": "Bonne soirée ist die Abendform von bonne journée."
                  },
                  "expressionIds": []
                }
              ]
            }
          ]
        }
      ]
