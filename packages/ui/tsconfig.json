{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ft/tsconfig/library.json",
  // No build step: @ft/ui ships TypeScript source and the Next compiler owns the
  // transform, which is why the 'use client' directives survive. Hence noEmit and
  // bundler resolution instead of the preset's CommonJS emit.
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
  },
  "include": ["src"],
  "exclude": ["node_modules"],
}
