{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@ft nextjs",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
  },
}
