# Nestjs specific
/dist
/node_modules
/build
/tmp

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# dotenv environment variable files. The wildcard is for the copies tools make
# next to it (.env.bak from make, .env.tmp.<pid> from .devcontainer/
# initialize.sh): each holds every secret in .env.
.env
.env.*
!.env.example

# temp directory
.temp
.tmp

# Generated by `next typegen` and `next build`. Not committed: Next writes a
# different import path under dev than under build, so a tracked copy is dirty
# after every switch between `make dev` and `make`. Every command that runs tsc
# regenerates it first.
apps/web/next-env.d.ts

# Monorepo build output (nested, the entries above only match the repo root)
node_modules/
dist/
build/
.next
out
*.tsbuildinfo

# Task + test caches and reports
.turbo
coverage
playwright-report
test-results
.pnpm-store

# VS Code: share the settings that make the repo build the same way for
# everyone, keep personal files (launch configs, local tasks) out.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Agents
AGENTS.md

# Local-only overrides and generated TLS material
*.local
certs
.claude/settings.local.json

# OS
.DS_Store
