          "items": [
            {
              "type": "grammar_explanation",
              "itemId": "block-voici-explanation",
              "ruleIds": ["rule-voici-voila", "rule-cest-vs-il-est"],
              "heading": {
                "en": "Showing, and saying a job",
                "fr": "Montrer, et dire un métier",
                "de": "Zeigen und einen Beruf nennen"
              },
              "text": {
                "en": "`voici` shows something close, `voilà` something farther away or just seen: `Voici ma sœur.` `Voilà le bus !`\n\nTo say a job, use `il est` or `elle est` **without an article**: `Il est médecin.` With an article, use `c'est`: `C'est un médecin.`\n\n- `Elle est étudiante.`\n- `C'est une étudiante.`",
                "fr": "`voici` montre ce qui est proche, `voilà` ce qui est plus loin ou qu'on vient de voir : `Voici ma sœur.` `Voilà le bus !`\n\nPour dire un métier, on emploie `il est` ou `elle est` **sans article** : `Il est médecin.` Avec un article, on emploie `c'est` : `C'est un médecin.`\n\n- `Elle est étudiante.`\n- `C'est une étudiante.`",
                "de": "`voici` zeigt etwas Nahes, `voilà` etwas Entfernteres oder gerade Gesehenes: `Voici ma sœur.` `Voilà le bus !`\n\nFür einen Beruf verwendest du `il est` oder `elle est` **ohne Artikel**: `Il est médecin.` Mit Artikel verwendest du `c'est`: `C'est un médecin.`\n\n- `Elle est étudiante.`\n- `C'est une étudiante.`"
              },
              "formTable": [
                { "subject": "ce qui est proche", "form": "voici", "example": "Voici ma sœur." },
                { "subject": "ce qui est plus loin", "form": "voilà", "example": "Voilà le bus !" },
                {
                  "subject": "il / elle + métier sans article",
                  "form": "il est",
                  "example": "Il est médecin."
                },
                { "subject": "avec un article", "form": "c'est", "example": "C'est un médecin." }
              ],
              "examples": [
                {
                  "text": "Voici ma sœur.",
                  "translation": { "en": "Here is my sister.", "de": "Hier ist meine Schwester." }
                },
                {
                  "text": "Voilà le bus !",
                  "translation": { "en": "There is the bus!", "de": "Da ist der Bus!" }
                },
                {
                  "text": "Il est médecin.",
                  "translation": { "en": "He is a doctor.", "de": "Er ist Arzt." }
                },
                {
                  "text": "C'est un médecin.",
                  "translation": { "en": "He is a doctor.", "de": "Das ist ein Arzt." }
                },
                {
                  "text": "Elle est étudiante.",
                  "translation": { "en": "She is a student.", "de": "Sie ist Studentin." }
                }
              ]
            }
          ]
        }
      ]
    },
