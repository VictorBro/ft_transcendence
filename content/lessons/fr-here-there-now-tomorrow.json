      "label": {
        "en": "When? maintenant, aujourd'hui, demain, bientôt",
        "fr": "Quand ? maintenant, aujourd'hui, demain, bientôt",
        "de": "Wann? maintenant, aujourd'hui, demain, bientôt"
      },
      "pages": [
        {
          "pageId": "block-time-explanation",
          "estimatedDurationS": 120,
          "timeLimitS": null,
          "instructions": {
            "en": "Read the explanation and the examples.",
            "fr": "Lisez l’explication et les exemples.",
            "de": "Lies die Erklärung und die Beispiele."
