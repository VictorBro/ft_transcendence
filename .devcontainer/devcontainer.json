// Devcontainer for ft_transcendence.
//
// This attaches to the `workspace` service, a plain shell container on the same
// compose network as the app. Editing happens here; web and api still run as
// their own services with their own dev images, exactly as `make dev` starts
// them. Nothing about the app depends on VS Code being open.
//
// Spec: https://containers.dev/implementors/json_reference/
{
  "name": "ft_transcendence",

  // Runs on the HOST before compose is read, on every open. It fits the
  // compose variables in .env to this machine's Docker daemon: on a rootless
  // one (the 42 clusters, no sudo) the container runs as root, gets the
  // per-user socket, and publishes no port below 1024. Where the values already
  // work, which is every rootful machine with free ports, it changes nothing.
  // The script header has the details.
  //
  // A string, so it goes through the host's shell, and `|| exit 0` because a
  // failing initializeCommand stops the container from opening at all: on a
  // host with no `sh` (plain Windows instead of WSL2) the defaults still apply.
  "initializeCommand": "sh .devcontainer/initialize.sh || exit 0",

  // Both files, in this order, so compose merges the dev overlay the same way a
  // bare `docker compose up` does. compose.override.yml is where the workspace
  // service, its named volumes and its env live.
  "dockerComposeFile": ["../compose.yml", "../compose.override.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspace",

  // The workspace service sits behind `profiles: [devcontainer]`, so plain
  // `docker compose up` skips it while naming it here activates the profile.
  //
  // Only the backing stores come up with it. Postgres and Redis are needed the
  // moment you run a migration or a test, whereas web, api and caddy are
  // started on demand with `make dev` and would otherwise sit there rebuilding
  // on every file save whether or not anyone is looking at them.
  "runServices": ["workspace", "db", "redis"],

  // Deliberate, and the opposite of the default. `stopCompose` would stop the
  // whole stack whenever the VS Code window closes, taking Postgres and Redis
  // with it and killing anything running under `make dev` in another terminal.
  // The cost of "none" is that the containers keep running after you close the
  // editor; `make down` stops them.
  "shutdownAction": "none",

  // The compose service already sets `command: sleep infinity` with init: true.
  // Overriding it would replace that PID 1 with the tool's own keepalive.
  "overrideCommand": false,

  // No "remoteUser" on purpose. VS Code then attaches as the user the workspace
  // service runs as, `user:` in compose.override.yml, and that one depends on
  // the machine:
  //
  //   node  On a rootful daemon. uid/gid 1000 in the image, which matches the
  //         first user account on a Linux host, so files written here are
  //         owned correctly on the host side too. When they differ, VS Code
  //         remaps the container uid automatically before attach.
  //   root  On a rootless daemon, where root in the container is your own user
  //         on the host. The remap above cannot work there (it would chown to
  //         a uid the daemon's user namespace does not have, "Invalid
  //         argument"), and VS Code skips it for root.
  //
  // Naming a user here would pin one of the two for everybody. Do not reach
  // for "updateRemoteUserUID": false either: it only skips the remap, the
  // session stays uid 1000 and still cannot write the repo on a rootless
  // daemon, and chowning the repo to make it writable hands the checkout to a
  // subuid your host user no longer owns.

  // The one sanctioned install. It runs on the developer's machine after the
  // container exists, not during an image build, so it never races the
  // lockfile in CI.
  //
  // `umask 022` first: this string runs as a bare `/bin/sh -c` through
  // `docker exec`, which on a rootless daemon starts with umask 000 and reads
  // none of the files the Dockerfile sets it in. Without it node_modules, the
  // pnpm store and the git hook runner come out world-writable. A no-op
  // everywhere else.
  "postCreateCommand": "umask 022 && pnpm install",

  // Compose resolves relative bind-mount paths on the docker DAEMON's side,
  // i.e. against the HOST filesystem. Shells inside this container therefore
  // need the host path of the repo for `make dev` / `docker compose` to mount
  // the right directories; the compose files consume it as
  // ${LOCAL_WORKSPACE_FOLDER:-.}. On the host the variable is unset and the
  // "." fallback keeps behaving exactly as before.
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },

  // No real features on purpose. Everything a feature would add (docker CLI,
  // gh, zsh, sudo) is in .devcontainer/Dockerfile instead, where the version is
  // visible and the layer is cached with the rest of the image.
  //
  // The one entry installs nothing. VS Code builds this image from a
  // Dockerfile it generates in its own temp folder, outside the repo. Compose
  // builds through Buildx Bake, and Bake only reads paths it was told about.
  // With no feature, nothing tells it about that folder, and "Reopen in
  // Container" stops at
  //   additional privileges requested: pass "--allow=fs.read=/tmp/
  //   devcontainercli-.../Dockerfile-with-features"
  // With any feature, the tool passes the folder as a named build context,
  // which is exactly the permission Bake wants. Seen 2026-11 with Compose 2.39
  // and 5.6 on Buildx 0.38, Dev Containers 0.475. Delete the entry, its folder
  // and devcontainer-lock.json (written next to this file once a feature
  // exists, and committed so nobody finds it untracked) when the Dev Containers
  // CLI allows its own Dockerfile. docs/VERSIONS.md says how to tell.
  "features": {
    "./features/bake-compat": {}
  },

  // No "forwardPorts" either. caddy publishes its ports straight to the host
  // (80, 443 and 443/udp, or HTTP_PORT and HTTPS_PORT from .env), so the app is
  // reachable from the host's browser with the container ports never entering
  // the picture.

  // NOTE for whoever owns compose.override.yml: the image carries the docker
  // CLI, buildx and compose plugins so `make` and `docker compose` work from
  // inside this shell, but a compose-based devcontainer takes its mounts from
  // the compose file, not from here. The workspace service therefore mounts
  // the host's Docker socket at /var/run/docker-host.sock, and its command
  // runs .devcontainer/docker-init.sh, which bridges that socket to a
  // node-owned /var/run/docker.sock via socat, the same mechanism as the
  // official docker-outside-of-docker feature, so plain `docker ps` works here
  // without sudo. As root on a rootless daemon it is a plain symlink.

  "customizations": {
    "vscode": {
      // Reinstalled automatically on every container rebuild. An extension
      // installed by hand instead lands in ~/.vscode-server/extensions, which
      // is why that path is also a named volume (compose.override.yml): what
      // this list does not cover survives rebuilds through the volume.
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "EditorConfig.EditorConfig",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",

        // Prettier has no Prisma parser, so schema.prisma needs the formatter
        // the Prisma extension ships. Without this it falls to the default
        // above and format-on-save silently does nothing.
        "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
        // ESLint fixes on save, Prettier formats on save. The two do not fight:
        // eslint-config-prettier is applied last in @ft/eslint-config, so no
        // lint rule has an opinion about layout.
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // ESLint 10 is flat-config only, and each package ships its own
        // eslint.config.*. "auto" resolves the config relative to the file
        // being linted instead of the repo root.
        "eslint.useFlatConfig": true,
        "eslint.workingDirectories": [{ "mode": "auto" }],

        // Use the workspace TypeScript (6.0.3, pinned) rather than whatever
        // version VS Code happens to bundle, which is what tsc and eslint see.
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "js/ts.tsdk.promptToUseWorkspaceVersion": true,

        // Tailwind v4 has no tailwind.config.js: the config is the CSS entry
        // point. The extension cannot guess that from a monorepo root.
        "tailwindCSS.experimental.configFile": "apps/web/app/globals.css",

        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.eol": "\n",

        // Compose already publishes every port. Auto-forwards add duplicates
        // that outlive the command and squat host ports on the next run.
        "remote.autoForwardPorts": false,

        // Without this VS Code guesses Markdown for the extensionless
        // CODEOWNERS, and format-on-save then rewrites its `*` catch-all into
        // a Markdown bullet. .prettierignore already blocks the formatter; this
        // also gives the file sane `#` comment highlighting. The ignore syntax
        // is the closest built-in match for its glob-and-comment format.
        "files.associations": {
          "CODEOWNERS": "ignore"
        },

        // The repo is a bind mount. Watching build output burns inotify
        // handles and produces nothing useful. .pnpm-store is the big one:
        // pnpm cannot hardlink across filesystems, so it keeps a project-local
        // store of roughly 35k files here.
        "files.watcherExclude": {
          "**/.next/**": true,
          "**/.pnpm-store/**": true,
          "**/.turbo/**": true,
          "**/coverage/**": true,
          "**/dist/**": true,
          "**/generated/**": true,
          "**/node_modules/**": true
        },
        "search.exclude": {
          "**/.next": true,
          "**/.pnpm-store": true,
          "**/.turbo": true,
          "**/coverage": true,
          "**/dist": true,
          "**/generated": true,
          "**/node_modules": true,
          "**/pnpm-lock.yaml": true
        }
      }
    }
  }
}
