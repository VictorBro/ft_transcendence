# Copy to .env and edit:  cp .env.example .env
#
# .env is gitignored and CI fails the build if it is ever staged. This file is
# the source of truth for variable NAMES: a hygiene job diffs the keys here
# against the keys in .env, so a new variable has to be added to both. Values
# below are non-secret local defaults and are safe to commit.
#
# Almost every key is read by compose.yml. Nothing else picks a variable up
# implicitly, so a variable that is not passed to a service in that file does
# nothing. The exceptions are tooling-only keys, read by a make target through
# `--env-file .env` and never by a running service: TOOLING_ONLY in
# scripts/check-env-example.sh lists them.

# --- runtime -----------------------------------------------------------------

# development for the dev stack, production for compose.prod.yml. The prod
# overlay hardcodes production, so this value only affects `docker compose up`.
NODE_ENV=development

# Reported by GET /api/health. Read through ConfigService, so the hygiene script
# cannot detect it by grepping for process.env: keep this entry by hand. CI can
# override it with the image tag to identify which build is running.
APP_VERSION=0.0.0

# --- postgres ----------------------------------------------------------------

# Role created on the database's first boot. Changing it later does nothing
# until the pg-data volume is recreated: the credentials are baked in at init.
POSTGRES_USER=ft

# Local development only. Anything that leaves a laptop needs a real secret,
# and it belongs in .env, never here.
POSTGRES_PASSWORD=ft_local_dev

# Database created at init, and the one infra/postgres/init/01-pgvector.sql
# installs the vector extension into.
POSTGRES_DB=ft_transcendence

# What Prisma connects with. Host `db` is the compose service name, reachable
# only from inside the network, so this URL does not work from the host shell.
# Nothing derives it from the three variables above: keep them in sync by hand.
DATABASE_URL=postgresql://ft:ft_local_dev@db:5432/ft_transcendence?schema=public

# --- redis -------------------------------------------------------------------

# Sessions (connect-redis), presence, placement runs, and the lesson discussion's
# rate limits.
# Not the throttler: @nestjs/throttler is configured without a storage adapter,
# so its counters are in process memory. Wire one in before running two api
# replicas, or the two would count separately.
REDIS_URL=redis://redis:6379

# Signs the session cookie. At least 32 characters, and a real secret outside
# local development: anyone holding it can forge a signed cookie. Rotating it
# logs everyone out.
#   openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-at-least-32-chars

# --- service to service ------------------------------------------------------

# Where Next.js server components reach NestJS. Plain http and no public port:
# TLS terminates at caddy and this hop never leaves the docker network.
API_INTERNAL_URL=http://api:3001

# --- proxy / remote access -----------------------------------------------------

# Ports caddy publishes on the host. Defaults are the standard ones. A machine
# that cannot bind ports below 1024 (rootless Docker on a sudo-less school
# computer) gets the first free ones from 8080 and 8443 up, written here by
# .devcontainer/initialize.sh, see the devcontainer section below; then open
# https://localhost:<HTTPS_PORT> directly (`make` prints it). The automatic
# http->https redirect only exists on the default ports.
HTTP_PORT=80
HTTPS_PORT=443

# Host ports for the dev stack only; production publishes neither. Change them
# if the default is already taken on your machine. Only the host side moves, so
# DATABASE_URL and REDIS_URL above stay unchanged.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Extra hostname caddy serves, for reaching a stack that runs on another machine
# (defence on a school computer, browser on your laptop). On YOUR device:
#   1. echo "<server-lan-ip> ft-transcendence.test" | sudo tee -a /etc/hosts
#   2. trust certs/ft-local-root.crt in the browser (make certs prints how)
# .test is reserved by RFC 6761 and never resolves publicly, so the made-up name
# cannot collide with a real site. Override per team taste.
CADDY_EXTRA_HOSTNAME=ft-transcendence.test

# --- devcontainer --------------------------------------------------------------

# Host-side path of this repository. Compose resolves relative bind mounts on
# the docker DAEMON's side (the host), so compose commands run from INSIDE the
# devcontainer need this to point the mounts at the real host path.
# devcontainer.json injects it into container shells automatically; leave it
# empty here and on the host, where the compose fallback "." is already correct.
LOCAL_WORKSPACE_FOLDER=

# The next two are filled in for you: .devcontainer/initialize.sh runs on the
# host before every "Reopen in Container", looks at the Docker daemon and
# writes what fits it. Empty is right for a rootful daemon, which is what
# Docker Desktop and a default Linux install run. It also moves the four *_PORT
# values above when the daemon cannot publish one (below 1024 without root) or
# another program already has it. Not opening the devcontainer from VS Code?
# Run `sh .devcontainer/initialize.sh` from a host shell: it is the same script.

# Who the devcontainer runs as. Empty means `node`. `root` on a rootless daemon
# (the 42 clusters), where root inside a container is your own user on the host
# and `node` cannot write the repo.
WORKSPACE_USER=

# Host path of the Docker socket handed to the devcontainer. Empty means
# /var/run/docker.sock. A rootless daemon listens on a per-user path instead,
# /run/user/<uid>/docker.sock.
DOCKER_SOCKET=

# --- LLM provider ------------------------------------------------------------
# Gemini (docs/architecture/product.md section 5). App code calls the LlmProvider
# interface, so swapping vendors is a config change plus one file.

# fixture | gemini | disabled, checked at boot. gemini generates questions when
# a level runs low. fixture calls nothing and writes no questions, so a learner
# who has seen a whole level gets the questions they saw longest ago; its tutor
# gives one canned answer. disabled is the same with no tutor at all: every
# lesson discussion ends with the error llm.disabled. CI only runs fixture.
LLM_PROVIDER=fixture

# Gemini API key, sent in a request header. The project runs on a free key:
# Google may train on what learners write to the tutor, and /privacy says so.
# A paid key or another vendor changes that page first (docs/architecture/product.md
# section 5). With gemini the api refuses to
# start without it. Empty on purpose: a real key in this file would be a
# committed credential.
LLM_API_KEY=

# Gemini model id. Empty means gemini-3.6-flash. Ignored by the fixture.
LLM_MODEL=

# Lesson discussion limits (#150), counted in Redis, checked before the answer
# streams. Over one, the api answers 429 with the seconds to wait. Empty means
# the default in brackets; anything but a whole number stops the start.
# Messages per learner per minute [2], and per learner per day [60]: the day
# starts at the learner's first message, not at midnight. Keep the minute one
# well under the global one below, or one learner can fill it for everyone.
LLM_DISCUSSION_USER_PER_MINUTE=
LLM_DISCUSSION_USER_PER_DAY=
# Messages per minute for everyone together [5]. Every learner shares one LLM
# key, and so do the question restocks: keep this under that key's per-minute
# quota (Google AI Studio shows it). 5 suits a free key, which refused calls
# after fewer than 10 in two minutes; raise it on a paid one.
LLM_DISCUSSION_GLOBAL_PER_MINUTE=

# --- rate limits -------------------------------------------------------------
# Per minute. Empty keeps the default, shown in each comment; anything but a
# positive integer stops the api at boot. The browser suite reads the signup
# and login ones too, through make, so it queues to the same numbers.

# Every route, per account, or per address when signed out. Default 100.
RATE_LIMIT_PER_MINUTE=

# Signups per address: each one writes a row and runs argon2. Default 20.
SIGNUP_LIMIT_PER_MINUTE=

# Password or 2FA code checks per address, on each route that makes one
# (login, the 2FA steps, disabling 2FA). Default 5.
LOGIN_LIMIT_PER_MINUTE=

# --- monitoring --------------------------------------------------------------

# Grafana's admin login at https://localhost/grafana (with :<HTTPS_PORT> when
# that is not 443), user `admin`. Empty on
# purpose: make writes a random one into .env on the first `make up`. Grafana
# reads it only when its database is created, so changing it later does
# nothing until you reset it (docs/operations/monitoring.md) or recreate grafana-data.
GRAFANA_ADMIN_PASSWORD=

# Replaces the secret_key Grafana ships with, which is published in its source.
# Generated by make like the password. Changing it later breaks what Grafana
# already encrypted, so set it once.
GRAFANA_SECRET_KEY=

# Discord channel webhook that Alertmanager posts alerts to. Leave it empty on
# a laptop: alerts then stay visible in Grafana and go nowhere, and `make`
# does not post its test runs to the team. It is a credential: anyone holding
# the URL can post to the channel.
DISCORD_WEBHOOK_URL=

# --- demo --------------------------------------------------------------------

# Password of the six demo learners (demo-anna@example.com to
# demo-felix@example.com) that `make` and `make seed` rebuild on every seed,
# with streaks, results and a finished level to look at. Empty means no demo
# learners. Set one to get them: it must pass the signup rules (12 to 128
# characters, a lowercase letter, an uppercase letter and a digit), or the seed
# fails. Do not quote it: `docker run --env-file` keeps the quotes as part of the
# value. Tooling only: the seed reads it, no compose file does, so no
# long-running service ever holds it. Only seeded when NODE_ENV is development.
DEMO_PASSWORD=
