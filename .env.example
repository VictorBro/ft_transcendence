# The one .env template, for a checkout and for a server.
#
# In a checkout, `make` creates .env from this file when there is none, writes
# the secrets it can generate, and appends keys added here since. On a server,
# copy it next to compose.deploy.yml as .env and fill it in
# (docs/operations/deployment.md). Either place, scripts/align-env.sh rewrites
# an existing .env in this file's order and comments and keeps every value.
#
# Every secret is empty on purpose. In a checkout, make generates the ones it
# can, compose.yml falls back to a local default for the others, and the rest
# are optional. A server refuses to start until each required one is set, so a
# copied template never runs production on a secret published here:
# scripts/check-env-example.sh fails if one of them gets a value.
#
# .env is gitignored and CI fails the build if it is ever staged. This file is
# the source of truth for variable NAMES: a hygiene job diffs the keys here
# against .env and the compose files, so a new variable is added here, to .env
# and to the compose file that passes it to a service. Nothing picks a variable
# up implicitly. A key only the seed reads goes to no running service: `make
# seed` hands it over with `--env-file .env`, the deploy's one-shot migrate
# service passes it on a server, and SEED_ONLY in scripts/check-env-example.sh
# keeps it off every other service.
#
# Three sections:
#   1. checkout and server   compose.yml, and compose.deploy*.yml on a server
#   2. server only           compose.deploy*.yml; a checkout ignores them
#   3. checkout only         compose.deploy.yml hardcodes or ignores them

# =============================================================================
# 1. checkout and server
# =============================================================================

# --- postgres ----------------------------------------------------------------
# Nothing else names the database: compose.yml, compose.deploy.yml and the
# Makefile build DATABASE_URL from these three. Leave them unquoted and free
# of quotes: compose drops only a pair of enclosing quotes, make and the
# scripts drop every quote, so the two would read another value.

# Role created on the database's first boot. Changing it later does nothing
# until the pg-data volume is recreated: the credentials are baked in at init.
POSTGRES_USER=ft

# Empty in a checkout: compose.yml and the Makefile fall back to ft_local_dev,
# the password the local pg-data volume was created with. Required on a server:
# compose.deploy.yml refuses to start without it. Hex, not base64: it goes into
# DATABASE_URL, and a `/` there breaks the parse.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Database created at init, and the one infra/postgres/init/01-pgvector.sql
# installs the vector extension into.
POSTGRES_DB=ft_transcendence

# --- sessions ----------------------------------------------------------------

# Signs the session cookie. At least 32 characters: anyone holding it can forge
# a signed cookie, and rotating it logs everyone out. In a checkout make writes
# a random one into .env, like the Grafana keys below, and compose.yml falls
# back to a dev value without make. Required on a server.
#   openssl rand -hex 32
SESSION_SECRET=

# --- LLM provider ------------------------------------------------------------
# Gemini (docs/architecture/product.md section 5). App code calls the LlmProvider
# interface, so swapping vendors is a config change plus one file.

# fixture | gemini | disabled, checked at boot. gemini generates questions when
# a level runs low. fixture calls nothing and writes no questions, so a learner
# who has seen a whole level gets the questions they saw longest ago; its tutor
# gives one canned answer. disabled is the same with no tutor at all: every
# lesson discussion ends with the error llm.disabled. CI only runs fixture.
# Empty means fixture in a checkout. A server refuses to start until one is
# chosen, so it never runs on repeats by accident.
LLM_PROVIDER=

# Gemini API key, sent in a request header. The project runs on a free key:
# Google may train on what learners write to the tutor, and /privacy says so.
# A paid key or another vendor changes that page first (docs/architecture/product.md
# section 5). With gemini the api refuses to
# start without it. Empty on purpose: a real key in this file would be a
# committed credential.
LLM_API_KEY=

# Gemini model id. Empty means gemini-3.6-flash. Ignored by the fixture.
# A free key allows few requests a day per model (20 for gemini-3.6-flash,
# checked on 2026-11-27): the tutor, the question restocks, each key check and
# any test run on a gemini stack spend them.
LLM_MODEL=

# Lesson discussion limits (#150), counted in Redis, checked before the answer
# streams. Over one, the api answers 429 with the seconds to wait. Empty means
# the default in brackets; anything but a whole number stops the start.
# Messages per learner per minute [5], and per learner per day [150]: the day
# starts at the learner's first message, not at midnight. Keep the minute one
# well under the global one below, or one learner can fill it for everyone.
LLM_DISCUSSION_USER_PER_MINUTE=
LLM_DISCUSSION_USER_PER_DAY=
# Messages per minute for everyone together [10]. Every learner shares one LLM
# key, and so do the question restocks: keep this under that key's per-minute
# quota (Google AI Studio shows it). If that quota is about 5, set 5 here and 3
# per learner above.
LLM_DISCUSSION_GLOBAL_PER_MINUTE=

# --- rate limits -------------------------------------------------------------
# Per minute. Empty keeps the default, shown in each comment; anything but a
# positive integer stops the api at boot. The browser suite reads the signup
# and login ones too, through make, so it queues to the same numbers.

# Every route, per account, or per address when signed out. Default 100.
RATE_LIMIT_PER_MINUTE=

# Signups per address: each one writes a row and runs argon2. Default 20.
SIGNUP_LIMIT_PER_MINUTE=

# Password or 2FA code checks per address, on each route that makes one
# (login, the 2FA steps, disabling 2FA). Default 20: every browser on one
# machine reaches the api as one address, so they all share it.
LOGIN_LIMIT_PER_MINUTE=

# --- monitoring --------------------------------------------------------------
# On a server, read only where compose.deploy.monitoring.yml sits next to
# compose.deploy.yml. Without it, leave these three empty.

# Grafana's admin login at https://localhost/grafana (with :<HTTPS_PORT> when
# that is not 443), or https://<SITE_DOMAIN>/grafana on a server, user `admin`.
# Empty on purpose: make writes a random one into .env on the first `make up`;
# on a server, set it by hand. Grafana reads it only when its database is
# created, so changing it later does nothing until you reset it
# (docs/operations/monitoring.md) or recreate grafana-data.
#   openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=

# Replaces the secret_key Grafana ships with, which is published in its source.
# Generated by make like the password; set by hand on a server. Changing it
# later breaks what Grafana already encrypted, so set it once.
#   openssl rand -hex 32
GRAFANA_SECRET_KEY=

# Discord channel webhook that Alertmanager posts alerts to. Leave it empty on
# a laptop: alerts then stay visible in Grafana and go nowhere, and `make`
# does not post its test runs to the team. Set it on the server. Each title
# starts with the sender: a server's SITE_DOMAIN, or a laptop's ALERT_SOURCE
# (section 3). It is a credential: anyone holding the URL can post to the
# channel.
DISCORD_WEBHOOK_URL=

# --- demo learners -----------------------------------------------------------

# Password of the six demo learners, demo-anna@example.com to
# demo-felix@example.com: streaks, results, a finished level, friends and
# unread messages to show. Empty, the seed builds none, and deletes none an
# earlier seed built (docs/operations/deployment.md, Demo learners, removes
# them). Set, every seed deletes them and builds them again: `make` and
# `make seed` in a checkout, the migrate service on each deploy of a server.
# Their today is the seed's, so reseed on the day you show them. The seed
# touches those six addresses only, and what cascades from them: their
# friendships and whole conversations, a real user's messages to them included.
# It must pass the signup rules (12 to 128 characters, a lowercase letter, an
# uppercase letter and a digit), or the seed fails. Keep to letters and digits,
# unquoted: `docker run --env-file` keeps quotes as part of the value, and
# compose reads a `$` as a variable.
# On a public server, whoever knows it can sign in as a demo learner and change
# what that learner shows (lessons, display name, avatar, 2FA) until the next
# deploy rebuilds them. Only the seed reads it, never the api.
DEMO_PASSWORD=

# =============================================================================
# 2. server only
# =============================================================================
# compose.deploy.yml and compose.deploy.proxy.yml read these; a checkout
# ignores them. The host holds compose.deploy.yml, the Caddyfile
# (infra/caddy/Caddyfile.prod, renamed) and this file as .env. A server that
# runs monitoring also gets compose.deploy.monitoring.yml, and one behind
# another reverse proxy compose.deploy.proxy.yml.

# The public hostname. It must resolve to the host before the stack starts, or
# Caddy burns a Let's Encrypt attempt failing to validate. Ours are
# trans.vyantares.ch (the primary, with monitoring, behind another proxy) and
# transcendence.dpdns.org (the Oracle copy, without monitoring).
SITE_DOMAIN=

# Where the certificate authority reports a renewal it could not complete.
# Still required behind another proxy, which then holds the certificate.
ACME_EMAIL=

# Which released images to run. `latest` follows main; pin a main-<sha> tag to
# hold a known-good release, and to roll back.
IMAGE_TAG=latest

# Behind another reverse proxy only: the Docker network it routes over.
# Empty means `web`.
PROXY_NETWORK=

# Uncomment it on every server, so ours share one .env, SITE_DOMAIN aside. It
# matters most on a host that also has a checkout of this repo: compose would
# name both stacks ft_transcendence, and the second would reuse the first's
# volumes, database included. Never set it in a checkout: the Makefile
# assumes ft_transcendence.
# COMPOSE_PROJECT_NAME=ft_transcendence_prod

# =============================================================================
# 3. checkout only
# =============================================================================
# compose.deploy.yml hardcodes each of these it needs, or never reads it. On a
# server they sit unused: editing them there changes nothing.

# --- runtime -----------------------------------------------------------------

# No service reads it: compose.override.yml hardcodes development,
# compose.prod.yml and compose.deploy.yml production. `make seed` and `make
# migrate` hand .env to the tooling container, where nothing reads it either.
NODE_ENV=development

# Reported by GET /api/health and the metrics. A server takes it from IMAGE_TAG.
APP_VERSION=0.0.0

# Sessions (connect-redis), presence, placement runs, and the lesson discussion's
# rate limits.
# Not the throttler: @nestjs/throttler is configured without a storage adapter,
# so its counters are in process memory. Wire one in before running two api
# replicas, or the two would count separately.
REDIS_URL=redis://redis:6379

# --- service to service ------------------------------------------------------

# Where Next.js server components reach NestJS. Plain http and no public port:
# TLS terminates at caddy and this hop never leaves the docker network.
API_INTERNAL_URL=http://api:3001

# --- proxy / remote access -----------------------------------------------------

# Ports caddy publishes on the host. Defaults are the standard ones. A machine
# that cannot bind ports below 1024 (rootless Docker on a sudo-less school
# computer) gets the first free ones from 8080 and 8443 up, written here by
# .devcontainer/initialize.sh, see the devcontainer section below; then open
# https://localhost:<HTTPS_PORT> directly (`make` prints it). The automatic
# http->https redirect only exists on the default ports.
HTTP_PORT=80
HTTPS_PORT=443

# Host ports for the dev stack only; production publishes neither. Change them
# if the default is already taken on your machine. Only the host side moves:
# inside the network they stay 5432 and 6379.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Extra hostname caddy serves, for reaching a stack that runs on another machine
# (defence on a school computer, browser on your laptop). On YOUR device:
#   1. echo "<server-lan-ip> ft-transcendence.test" | sudo tee -a /etc/hosts
#   2. trust certs/ft-local-root.crt in the browser (make certs prints how)
# .test is reserved by RFC 6761 and never resolves publicly, so the made-up name
# cannot collide with a real site. Override per team taste.
CADDY_EXTRA_HOSTNAME=ft-transcendence.test

# --- devcontainer --------------------------------------------------------------

# Host-side path of this repository. Compose resolves relative bind mounts on
# the docker DAEMON's side (the host), so compose commands run from INSIDE the
# devcontainer need this to point the mounts at the real host path.
# devcontainer.json injects it into container shells automatically; leave it
# empty here and on the host, where the compose fallback "." is already correct.
LOCAL_WORKSPACE_FOLDER=

# The next two are filled in for you: .devcontainer/initialize.sh runs on the
# host before every "Reopen in Container", looks at the Docker daemon and
# writes what fits it. Empty is right for a rootful daemon, which is what
# Docker Desktop and a default Linux install run. It also moves the four *_PORT
# values above when the daemon cannot publish one (below 1024 without root) or
# another program already has it. Not opening the devcontainer from VS Code?
# Run `sh .devcontainer/initialize.sh` from a host shell: it is the same script.

# Who the devcontainer runs as. Empty means `node`. `root` on a rootless daemon
# (the 42 clusters), where root inside a container is your own user on the host
# and `node` cannot write the repo.
WORKSPACE_USER=

# Host path of the Docker socket handed to the devcontainer. Empty means
# /var/run/docker.sock. A rootless daemon listens on a per-user path instead,
# /run/user/<uid>/docker.sock.
DOCKER_SOCKET=

# --- alerts ------------------------------------------------------------------

# Who sent an alert: the `source` label Prometheus puts on every alert, and the
# start of each Discord title. Empty: make sets `local (<git user.name>)`, so a
# laptop's alerts name their owner. A server ignores it and uses SITE_DOMAIN.
ALERT_SOURCE=
